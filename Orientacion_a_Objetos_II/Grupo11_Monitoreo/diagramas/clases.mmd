classDiagram
    class Sensor {
        +nombre str
        +ubicacion str
        -_temperatura float
        -_humedad float
        -_observadores list
        -_estrategia EstrategiaEvaluacion
        -_estado Estado
        -_resultado bool_o_None
        +registrar_observador(observador)
        +quitar_observador(observador)
        +iniciar() bool
        +cambiar_mediciones(temperatura, humedad) bool
        +cambiar_estrategia(estrategia) bool_o_None
        -_notificar()
        -_evaluar() bool
        +resumen() str
    }
    class Observador {
        <<abstract>>
        +actualizar(nombre, ubicacion, temperatura, humedad)*
    }
    class ObservadorConsola {
        +identificador str
        +actualizar(nombre, ubicacion, temperatura, humedad)
    }
    class EstrategiaEvaluacion {
        <<abstract>>
        +evaluar(temperatura, humedad) bool*
        +describir() str*
    }
    class EvaluacionTemperatura {
        +limite float = 30
        +evaluar(temperatura, humedad) bool
        +describir() str
    }
    class EvaluacionHumedad {
        +limite float = 70
        +evaluar(temperatura, humedad) bool
        +describir() str
    }
    class Estado {
        <<enumeration>>
        CONFIGURADO
        MONITOREANDO
        ALERTA
    }
    Sensor "0..*" --> "0..*" Observador : suscripciones
    Sensor "0..*" --> "1" EstrategiaEvaluacion : seleccionada
    Sensor --> Estado : estado actual
    Observador <|-- ObservadorConsola
    EstrategiaEvaluacion <|-- EvaluacionTemperatura
    EstrategiaEvaluacion <|-- EvaluacionHumedad
